<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="desktop-menu" label="Workspaces">
    <item label="1  WORK — code and terminal"><action name="GoToDesktop"><to>1</to></action></item>
    <item label="2  AGENT — Pi Agent and channel"><action name="GoToDesktop"><to>2</to></action></item>
    <item label="3  RUN — experiment and monitor"><action name="GoToDesktop"><to>3</to></action></item>
  </menu>
  <menu id="root-menu" label="CDMX Local AI">
    <menu id="desktop-menu"/>
    <item label="Show all open windows"><action name="ShowMenu"><menu>client-list-combined-menu</menu></action></item>
    <separator/>
    <item label="New Terminal  (Ctrl+Alt+T)">
      <action name="Execute"><command>/opt/cdmx-local-ai/device/desktop/open-terminal.sh</command></action>
    </item>
    <item label="Workspace Terminal">
      <action name="Execute"><command>/opt/cdmx-local-ai/device/desktop/open-terminal.sh workspace</command></action>
    </item>
    <item label="Experiment Terminal">
      <action name="Execute"><command>/opt/cdmx-local-ai/device/desktop/open-terminal.sh experiment</command></action>
    </item>
    <item label="Code Editor — Geany  (Ctrl+Alt+E)">
      <action name="Execute"><command>/opt/cdmx-local-ai/device/desktop/open-editor.sh</command></action>
    </item>
    <item label="Terminal Editor — Nano">
      <action name="Execute"><command>/opt/cdmx-local-ai/device/desktop/open-nano.sh</command></action>
    </item>
    <separator/>
    <item label="Pi Agent  (Ctrl+Alt+P)">
      <action name="Execute"><command>xterm -title 'Pi Agent' -geometry 100x30 -fa Monospace -fs 10 -bg '#0b1020' -fg '#e5e7eb' -e /opt/cdmx-local-ai/device/desktop/pi-terminal.sh</command></action>
    </item>
    <item label="System Monitor">
      <action name="Execute"><command>/opt/cdmx-local-ai/device/desktop/open-monitor.sh</command></action>
    </item>
    <separator/>
    <item label="Hide/show all windows  (Super+D)"><action name="ToggleShowDesktop"/></item>
    <item label="Close active window  (Alt+F4)"><action name="Close"/></item>
    <item label="Refresh desktop"><action name="Reconfigure"/></item>
  </menu>
</openbox_menu>
