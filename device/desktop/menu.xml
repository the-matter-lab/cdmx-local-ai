<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="CDMX Local AI">
    <item label="New Terminal">
      <action name="Execute">
        <command>/opt/cdmx-local-ai/device/desktop/open-terminal.sh</command>
      </action>
    </item>
    <item label="Workspace Terminal">
      <action name="Execute">
        <command>/opt/cdmx-local-ai/device/desktop/open-terminal.sh workspace</command>
      </action>
    </item>
    <item label="Workspace Editor (Nano)">
      <action name="Execute">
        <command>/opt/cdmx-local-ai/device/desktop/open-editor.sh</command>
      </action>
    </item>
    <separator/>
    <item label="Pi Agent">
      <action name="Execute">
        <command>xterm -title 'Pi Agent' -geometry 100x30 -fa Monospace -fs 10 -bg '#0b1020' -fg '#e5e7eb' -e /opt/cdmx-local-ai/device/desktop/pi-terminal.sh</command>
      </action>
    </item>
    <item label="System Monitor">
      <action name="Execute">
        <command>/opt/cdmx-local-ai/device/desktop/open-monitor.sh</command>
      </action>
    </item>
    <separator/>
    <item label="Close Active Window">
      <action name="Close"/>
    </item>
    <item label="Refresh Desktop Menu">
      <action name="Reconfigure"/>
    </item>
  </menu>
</openbox_menu>
