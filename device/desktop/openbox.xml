<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus><focusNew>yes</focusNew><followMouse>no</followMouse></focus>
  <desktops><number>1</number></desktops>
  <applications>
    <application title="System Status">
      <decor>no</decor><layer>above</layer>
      <position force="yes"><x>0</x><y>0</y></position>
      <size><width>1280</width><height>52</height></size>
    </application>
    <application title="Pi Agent">
      <position force="yes"><x>0</x><y>52</y></position>
      <size><width>640</width><height>332</height></size>
    </application>
    <application title="Channel + Workspace">
      <position force="yes"><x>0</x><y>384</y></position>
      <size><width>640</width><height>336</height></size>
    </application>
  </applications>
  <keyboard>
    <keybind key="C-A-t">
      <action name="Execute">
        <command>/opt/cdmx-local-ai/device/desktop/open-terminal.sh</command>
      </action>
    </keybind>
    <keybind key="C-A-e">
      <action name="Execute">
        <command>/opt/cdmx-local-ai/device/desktop/open-editor.sh</command>
      </action>
    </keybind>
    <keybind key="C-A-p">
      <action name="Execute">
        <command>xterm -title 'Pi Agent' -geometry 100x30 -fa Monospace -fs 10 -bg '#0b1020' -fg '#e5e7eb' -e /opt/cdmx-local-ai/device/desktop/pi-terminal.sh</command>
      </action>
    </keybind>
    <keybind key="W-space">
      <action name="ShowMenu"><menu>root-menu</menu></action>
    </keybind>
    <keybind key="A-F4"><action name="Close"/></keybind>
  </keyboard>
  <mouse>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu"><menu>root-menu</menu></action>
      </mousebind>
    </context>
  </mouse>
  <menu>
    <file>/opt/cdmx-local-ai/device/desktop/menu.xml</file>
  </menu>
</openbox_config>
