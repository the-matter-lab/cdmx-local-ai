[Unit]
Description=Finish CDMX runtime setup on first boot
After=local-fs.target cdmx-personalize.service
Before=NetworkManager.service ssh.service avahi-daemon.service cdmx-network.service
ConditionPathExists=/etc/cdmx/needs-runtime-init

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cdmx-first-boot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
