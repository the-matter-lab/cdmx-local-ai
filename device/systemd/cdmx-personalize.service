[Unit]
Description=Apply CDMX team identity from the SD FAT boot partition
After=local-fs.target rsetup.service
Wants=rsetup.service
Before=NetworkManager.service ssh.service avahi-daemon.service cdmx-network.service
RequiresMountsFor=/config

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cdmx-personalize
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
