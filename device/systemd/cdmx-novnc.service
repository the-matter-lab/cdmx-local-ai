[Unit]
Description=CDMX noVNC web gateway
After=network.target cdmx-desktop.service
Requires=cdmx-desktop.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=cdmx
Group=cdmx
Environment=CDMX_ROOT=/opt/cdmx-local-ai
ExecStart=/opt/cdmx-local-ai/device/desktop/start-novnc.sh
Restart=on-failure
RestartSec=3
RuntimeDirectory=cdmx-novnc
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=128M

[Install]
WantedBy=multi-user.target
