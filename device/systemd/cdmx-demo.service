[Unit]
Description=CDMX headless Bayesian optimization demo
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=cdmx
Group=cdmx
Environment=CDMX_ROOT=/opt/cdmx-local-ai
Environment=MPLCONFIGDIR=/run/cdmx-demo/matplotlib
ExecStart=/opt/cdmx-local-ai/device/demo/run-demo.sh
Restart=always
RestartSec=3
Nice=10
RuntimeDirectory=cdmx-demo
StateDirectory=cdmx-local-ai/demo
UMask=0027
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX
MemoryMax=320M
CPUQuota=35%

[Install]
WantedBy=multi-user.target
