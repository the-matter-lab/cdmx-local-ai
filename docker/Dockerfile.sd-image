FROM scratch

ARG IMAGE_VERSION=dev
LABEL org.opencontainers.image.title="CDMX Radxa ZERO 3W workshop SD image" \
      org.opencontainers.image.description="Compressed, flashable RadxaOS workshop image and SHA-512 checksum" \
      org.opencontainers.image.source="https://github.com/the-matter-lab/cdmx-local-ai" \
      org.opencontainers.image.version="${IMAGE_VERSION}"

COPY cdmx-workshop-golden.img.xz.sha512 /image/cdmx-workshop-golden.img.xz.sha512
COPY docker-parts/part-000 /image/parts/part-000
COPY docker-parts/part-001 /image/parts/part-001
COPY docker-parts/part-002 /image/parts/part-002
COPY docker-parts/part-003 /image/parts/part-003
COPY docker-parts/part-004 /image/parts/part-004
COPY docker-parts/part-005 /image/parts/part-005
COPY docker-parts/part-006 /image/parts/part-006
COPY docker-parts/part-007 /image/parts/part-007
COPY docker-parts/part-008 /image/parts/part-008
COPY docker-parts/part-009 /image/parts/part-009
COPY docker-parts/part-010 /image/parts/part-010
COPY docker-parts/part-011 /image/parts/part-011
COPY docker-parts/part-012 /image/parts/part-012
COPY docker-parts/part-013 /image/parts/part-013
COPY docker-parts/part-014 /image/parts/part-014
COPY docker-parts/part-015 /image/parts/part-015
COPY docker-parts/part-016 /image/parts/part-016
COPY docker-parts/part-017 /image/parts/part-017
COPY docker-parts/part-018 /image/parts/part-018
COPY docker-parts/part-019 /image/parts/part-019
